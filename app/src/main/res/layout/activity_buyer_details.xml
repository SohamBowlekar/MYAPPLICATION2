<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF6E5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:orientation="vertical">

        <!-- TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Order Details"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="16dp"/>

        <!-- SELECTED PRODUCTS TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selected Products"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="8dp"/>

        <!-- SELECTED PRODUCTS LIST -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSelectedProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>

        <!-- DIVIDER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- BUYER DETAILS TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Buyer Details"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="20dp"/>

        <!-- BUYER NAME -->
        <EditText
            android:id="@+id/edtBuyerName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Buyer Name"
            android:padding="12dp"/>

        <!-- CONTACT -->
        <EditText
            android:id="@+id/edtBuyerContact"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Contact Number"
            android:inputType="phone"
            android:padding="12dp"
            android:layout_marginTop="12dp"/>

        <!-- ADDRESS -->
        <EditText
            android:id="@+id/edtBuyerAddress"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Address"
            android:gravity="top"
            android:padding="12dp"
            android:layout_marginTop="12dp"/>

        <!-- TOTAL PRICE -->
        <TextView
            android:id="@+id/txtTotalPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total Price: ₹0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:gravity="center"/>

        <!-- ✅ NEW PAYMENT BUTTON -->
        <Button
            android:id="@+id/btnPayment"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Proceed to Payment"
            android:layout_marginTop="15dp"
            android:textSize="16sp"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"/>

        <!-- CONFIRM BUTTON -->
        <Button
            android:id="@+id/btnConfirmOrder"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Confirm Order"
            android:layout_marginTop="20dp"
            android:textSize="16sp"
            android:backgroundTint="#6A5ACD"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</ScrollView>