<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8E1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TITLE -->
        <TextView
            android:text="Main Distributor Dashboard"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- DISTRIBUTOR NAME -->
        <EditText
            android:id="@+id/etDistributorName"
            android:hint="Distributor Name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- PRODUCT NAME -->
        <EditText
            android:id="@+id/etProductName"
            android:hint="Product Name"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- CATEGORY -->
        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- QUANTITY -->
        <EditText
            android:id="@+id/etProductQty"
            android:hint="Quantity (1 set = 24 bottles)"
            android:inputType="number"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- PRICE -->
        <EditText
            android:id="@+id/etProductPrice"
            android:hint="Price"
            android:inputType="number"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- IMAGE PREVIEW -->
        <ImageView
            android:id="@+id/imgPreview"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:background="#DDDDDD"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:scaleType="centerCrop"/>

        <!-- SELECT IMAGE -->
        <Button
            android:id="@+id/btnSelectImage"
            android:text="Select Image"
            android:layout_marginTop="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- ADD PRODUCT -->
        <Button
            android:id="@+id/btnAddProduct"
            android:text="Add Product"
            android:background="#4CAF50"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- PRODUCTS TITLE -->
        <TextView
            android:text="Added Products:"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- ✅ FIXED SCROLLING PRODUCT LIST -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/productRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="10dp"/>

        <!-- OPTIONS -->
        <TextView
            android:text="Options"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- VIEW ORDER REQUESTS (NEW) -->
        <Button
            android:id="@+id/btnViewOrders"
            android:text="View Order Requests"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- VIEW COMPLAINTS -->
        <Button
            android:id="@+id/btnViewComplaints"
            android:text="View Complaints"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- GLASS BOTTLE RETURN -->
        <Button
            android:id="@+id/btnGlassBottleReturn"
            android:text="See Glass Bottle Returns"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- LOGOUT -->
        <Button
            android:id="@+id/btnLogout"
            android:text="Logout"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>